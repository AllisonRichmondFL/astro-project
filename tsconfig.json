{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@components/*": ["src/components/*"],
			"@layouts/*": ["src/layouts/*"],
			"@BANNER/*": ["src/_foundation/BANNER/*"],
			"@LOYALTY/*": ["src/_development/LOYALTY/*"],
			"@PRODUCT/*": ["src/_development/PRODUCT/*"],
			"@SEARCH/*": ["src/_development/SEARCH/*"],
			"@utils/*": ["src/utils/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	}
}
