---
import type { Results } from "src/pages/header.json";
import HeaderNavItem from "./HeaderNavItem.astro";

const route = new URL("/header.json", Astro.url);
const results: Results = await fetch(route).then((r) => r.json());

let selectedMenu = 10; // not a real section
---

<nav class="sticky inset-0 bottom-auto text-center py-1 px-4" data-id="Header-Desktop-Navbar">
	<!-- <pre class="text-tiny">{JSON.stringify(results)}</pre> -->
	<ul class="flex justify-center gap-4 m-auto">
		{
			results.sections.map((item, i) => (
				<li>
					<HeaderNavItem {...item} isSelected={i === selectedMenu} />
				</li>
			))
		}
	</ul>
</nav>
