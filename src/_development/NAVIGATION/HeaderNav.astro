---
import HeaderNavItem from "./HeaderNavItem.astro";

// const route = new URL("/header.json", Astro.url);
// const header: SearchResults = await fetch(route).then((r) => r.json());
const header = Astro.locals.header;

let selectedMenu = 10; // not a real section
---

<nav class="sticky inset-0 bottom-auto text-center py-1 px-4">
	<!-- <pre class="text-tiny">{JSON.stringify(header)}</pre> -->
	<ul class="flex justify-center gap-4 m-auto">
		{
			header?.sections?.map((item, i) => (
				<li>
					<HeaderNavItem {...item} isSelected={i === selectedMenu} />
				</li>
			))
		}
	</ul>
</nav>
