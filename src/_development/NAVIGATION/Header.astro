---
import HeaderNav from "./HeaderNav.astro";
import { getBannerFromAstro } from "@BANNER/banner.configs";
import AccountLogin from "./AccountLogin.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import SearchForm from "@SEARCH/SearchForm.astro";
import Logo from "@NAVIGATION/Logo.astro";
import MiniCartTrigger from "@NAVIGATION/MiniCartTrigger";
import IconLink from "./IconLink.astro";

const banner = getBannerFromAstro(Astro);
const locale = Astro.currentLocale ?? Astro.preferredLocale!;
const homeUrl = `/${locale}/`;
const cartUrl = `/${locale}/cart`;
const favesUrl = `/${locale}/account/favorites`;
---

<header class="bg-white text-black border-b border-b-neutral-500/30">
	<div class="max-w-screen-xl mx-auto flex gap-4 items-center justify-between px-4 py-2">
		<p data-id="Logo" class="">
			<a href={homeUrl}> <Logo /></a>
		</p>

		<SearchForm />

		<div class="flex gap-4 items-center">
			<LanguageSwitcher />

			<AccountLogin />
		</div>
	</div>
	<div data-id="Header-Desktop-Ribbon2" class="border-t border-neutral-500/20">
		<div class="max-w-screen-xl mx-auto flex gap-4 items-center justify-between px-4 py-2">
			<div class="h-8 mx-auto">
				<!-- <HeaderNav /> -->
			</div>

			<div class="ml-auto flex gap-4 items-center" data-id="Header-Desktop-Icons">
				<IconLink emoji="❤️" label="Favorites" url={favesUrl} />

				<MiniCartTrigger client:idle>
					<IconLink emoji="🛒" label="Cart" url={cartUrl} />
				</MiniCartTrigger>
			</div>
		</div>
	</div>
</header>
