---
import HeaderNav from "./HeaderNav.astro";
import { getBannerFromAstro } from "@BANNER/banner.configs";
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import SearchForm from "@SEARCH/SearchForm.astro";

const banner = getBannerFromAstro(Astro);
const locale = Astro.currentLocale ?? Astro.preferredLocale!;
const homeUrl = getRelativeLocaleUrl(locale, "/");
---

<header class="">
	<div class="flex gap-4 justify-between px-4 py-2 border-b border-b-neutral-500 bg-white text-black">
		<p data-id="Logo" class="">
			<a href={homeUrl} class="text-inherit">
				<img src={`/${banner.bannerType}/logo.svg`} alt={banner.name} title={`${banner.name} (home)`} height="30" />
			</a>
		</p>

		<SearchForm />

		<LanguageSwitcher />
	</div>
	<!-- <HeaderNav /> -->
</header>
