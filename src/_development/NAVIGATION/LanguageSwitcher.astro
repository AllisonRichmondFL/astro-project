---
import config from "astro.config.mjs";
import { banners, getBannerFromAstro } from "@BANNER/banner.configs";
import { getLanguageName } from "@BANNER/locale.configs";
const LOCALE = "locale";

const action = undefined; // `/${Astro.currentLocale}/`;
const method = undefined; // "POST";

const banner = getBannerFromAstro(Astro);

const allLocales = config?.i18n?.locales!;
const languages = banner.languages;
const locale = Astro.currentLocale ?? Astro.preferredLocale!;

if (languages.length < 2) {
	return null;
}
// if (Astro.request.method) {
// 	console.log("Astro.request.method:", Astro.request.method);
// }
if (Astro.request.method === "POST") {
	try {
		const data = await Astro.request.formData();
		const val = data.get(LOCALE)?.toString();
		console.log("LanguageSwitcher POST val:", val);
		if (val) {
			const redirectTo = `/${val}/`;
			console.log("LanguageSwitcher:", { redirectTo });
			Astro.redirect(redirectTo);
			// Astro.cookies.set(LOCALE, val, { path: "/" });
			// console.log("BannerSetForm POST:", { siteId }, banner);
		}
	} catch (err) {
		if (err instanceof Error) {
			console.error("❌", err.message);
		}
	}
}
---

<div class="flex flex-row items-center gap-6">
	<!-- <p class="">Current Locale: <code>{Astro.params.locale}</code></p> -->
	<details class="relative">
		<summary class="bg-neutral-500/50x py-1">Change locale: <code>{Astro.params.locale}</code></summary>
		<div class="absolute left-0 right-0 p-2 bg-neutral-800">
			<ul class="flex flex-col gap-2">
				{
					languages.map((language) => (
						<li value={language.lang}>
							<a href={`/${language.lang}/`} aria-selected={language.lang === locale} class="aria-selected:underline">
								{getLanguageName(language.locale)} ({language.lang})
							</a>
						</li>
					))
				}
			</ul>
			<!-- <hr class="my-2" />
			<em>All locales:</em>
			<ul class="">
				{
					allLocales.map(({ path, codes }) => (
						<li value={path}>
							<a href={`/${path}/`} aria-selected={path === locale} class="aria-selected:underline">
								{getLanguageName(codes[1])} ({path})
							</a>
						</li>
					))
				}
			</ul> -->
		</div>
	</details>
	<!-- <form action={action} method={method} class="flex flex-row items-center gap-3">
		<p class="mr-4">Current Locale: <code>{Astro.params.locale}</code></p>
		<label for={`select_${LOCALE}`} class="mr-2">Change locale:</label>
		<select name={LOCALE} id={`select_${LOCALE}`} class="inline-block p-1 font-inherit bg-neutral-500/40 text-inherit">
			{
				allLocales.map(({ path }) => (
					<option value={path} selected={path === locale}>
						{path}
