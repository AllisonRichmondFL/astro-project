---

<form
	action={action}
	method={method}
	class="flex flex-row items-center border border-neutral-500/30 rounded transition-colors bg-white hover:bg-neutral-100 w-1/2"
>
	<label for={`select_${QUERY}`} class="sr-only">Search</label>
	<input
		id={`select_${QUERY}`}
		name={QUERY}
		placeholder="Search"
		type="search"
		value={defaultValue}
		class="inline-block w-full py-2 px-3 text-sm leading-tight bg-transparent text-inherit outline-offset-1"
	/>
	<button class="inline-block py-2 px-2.5 text-sm leading-tight bg-transparent text-inherit" type="submit">🔍</button>
</form>
