---
import ProductImage from "@PRODUCT/ProductImage.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Price {
	value: number;
	formattedValue: string;
}
interface ProductPrice {
	salePrice: number;
	formattedSalePrice: string;
	formattedListPrice: string;
	listPrice: number;
}
interface ProductImage {
	url?: string;
	format: string;
	altText: string;
}
interface StyleVariant {
	color: string;
	imageSku: string;
	images: ProductImage[];
	name: string;
	flagsAndRestrictions: Record<string, boolean>;
	price: ProductPrice;
	review: {
		totalReviews: number;
		averageRating: number;
	};
	sku: string;
}

export interface Props {
	name: string;
	sku: string;
	badges: Record<string, boolean>;
	originalPrice: Price;
	price: Price;
	reviewRatings: {
		reviews: number;
		rating: number;
	};
	baseOptions: {
		selected: {
			mapEnable: boolean;
			style: string; // color
		};
	}[];
	images: ProductImage[];
	sellable: boolean;
	variantOptions?: StyleVariant[];
	variantsCount?: number;
}

const currentLocale = Astro.currentLocale ?? Astro.preferredLocale!;
const product = Astro.props;
const [name, gender] = product.name.split(" - ");
const style = product.baseOptions?.[0]?.selected.style;
const productImage = product.images?.[0]?.url;
---

<div data-id="ProductCard">
	<a
		href={getRelativeLocaleUrl(
			currentLocale,
			`/product/${product.name.replaceAll(" ", "-").toLowerCase()}/${product.sku}.html`
		)}
	>
		<ProductImage src={productImage} sku={product.sku} alt={product.name} height={120} width={120} />
	</a>
	<h3 class="text-2xl">{name}</h3>
	<p class="my-2 text-xs">⭐️ {product.reviewRatings.rating} <span>({product.reviewRatings.reviews})</span></p>
	<p class="text-xs">
		<span class="block">{gender}</span>
		<span class="sr-only">-</span>
		<span class="block">{style}</span>
	</p>
	<p>{product.price.formattedValue}</p>
	<!-- <pre class="text-tiny whitespace-pre-wrap">{JSON.stringify(product, null, 2)}</pre> -->
	{
		product.variantOptions?.length && (
			<ul class="flex gap-2">
				<li>
					<button class="border border-neutral-500/50">
						<ProductImage src={productImage} sku={product.sku} alt={product.name} height={35} width={35} />
					</button>
				</li>
				{product.variantOptions.map(({ images, imageSku, name, sku }) => (
					<li>
						<button class="border border-neutral-500/50">
							<ProductImage src={imageSku || images?.[0]?.url} sku={sku} alt={name} height={35} width={35} />
						</button>
					</li>
				))}
			</ul>
		)
	}
</div>
