---
interface Props extends astroHTML.JSX.ImgHTMLAttributes {
	alt: string;
	src?: string;
	sku?: string;
	height: number;
	width?: number | undefined;
}
const { alt, sku, src, height, width = height, ...rest } = Astro.props;

function setImageDimensions(url: string, height = 200, width = height) {
	if (!url || typeof url !== "string") return "";
	try {
		const imageUrl = new URL(url);
		imageUrl.searchParams.set("hei", height.toString());
		imageUrl.searchParams.set("wid", width.toString());
		return imageUrl.toString();
	} catch (err) {
		console.error(err);
		return "";
	}
}
const fileSrc = src || (sku && `https://images.footlocker.com/is/image/EBFL2/${sku}`)!;
const imgSrc = setImageDimensions(fileSrc, width, height);
if (!imgSrc) return null;
---

<img src={imgSrc} alt={alt} height={height} width={width} {...rest} />
