---
import FooterNav from "@layouts/FooterNav.astro";
import HeaderNav from "./HeaderNav.astro";
import BannerSetForm from "@BANNER/BannerSetForm.astro";
import { getBannerFromAstro } from "@utils/banner.configs";
import config from "astro.config.mjs";
import BannerName from "@BANNER/BannerName.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
// import { ViewTransitions } from "astro:transitions";

interface Props {
	canonical?: string;
	description?: string;
	title: string;
}
const { canonical, description = "This is an Astro project", title } = Astro.props;

const locales = config?.i18n?.locales!;

const banner = getBannerFromAstro(Astro);
const locale = Astro.currentLocale ?? Astro.preferredLocale!;
const homeUrl = getRelativeLocaleUrl(locale, "/");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<!-- <meta name="generator" content={Astro.generator} /> -->
		<title>{title} | {banner.name}</title>
		<slot name="head" />
		<!-- <ViewTransitions /> -->
	</head>

	<body>
		{import.meta.env.DEV && <BannerSetForm />}
		<header class="px-4 py-2 border-y border-t-blue-600/50 border-b-black/50 bg-blue-900/60">
			<div class="flex gap-4">
				<p class="mr-auto">
					<a href={homeUrl} class="text-inherit">
						<em>{banner.name}</em>
						<span class="text-xs">(home)</span>
					</a>
				</p>

				<p>Locales: <code>{locales.map(({ path }) => path).join("|")}</code></p>
				<p>Current Locale: <code>{Astro.params.locale}</code></p>
			</div>
		</header>
		<!-- <HeaderNav /> -->
		<slot />
		<!-- <FooterNav /> -->
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(45deg, rgb(var(--accent)), rgb(var(--accent-light)) 30%, white 60%);
	}
	html {
		font-family: system-ui, sans-serif;
		font-size: 16px;
		background: #13151a;
		background-size: 224px;
		color: white;
	}
	a {
		color: #7cf;
	}
	a:hover {
		color: #4bf;
		text-decoration: underline;
	}
	main {
		margin: auto;
		padding: 1rem;
		max-width: calc(100% - 2rem);
		/* width: 800px; */
		line-height: 1.5;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}

	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
</style>
