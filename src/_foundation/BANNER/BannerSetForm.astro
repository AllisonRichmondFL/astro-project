---

<div
	class="px-2 bg-slate-900 flex justify-between items-center text-xs transition-opacity opacity-75 hover:opacity-100"
>
	<p class="inline">
		Current Banner: <code>{JSON.stringify(banner.siteId)}</code>
	</p>

	<p class="opacity-75">
		<a href="https://docs.astro.build/en/reference/dev-toolbar-app-reference/" target="astro"
			><em>(TO DO: add dev toolbar integration for banner-switching)</em> ↗</a
		>
	</p>

	<form action={action} method={method} class="flex flex-row items-center">
		<label for={`select_${SITE_ID}`} class="opacity-80 mr-2">Change banner:</label>
		<select
			name={SITE_ID}
			id={`select_${SITE_ID}`}
			class="inline-block p-1 font-inherit bg-neutral-500/40 text-inherit"
		>
			{
				Object.entries(bannerGroups).map(([region, banners]) => (
					<optgroup label={region}>
						{banners.map(({ host, siteId }) => (
							<option value={siteId} selected={siteId === banner.siteId}>
								{host}
							</option>
						))}
					</optgroup>
				))
			}
		</select>
		<button
			class="inline-block py-1 px-1.5 ml-px font-inherit leading-snug bg-neutral-500/40 text-inherit"
			type="submit">→</button
		>
	</form>
</div>
