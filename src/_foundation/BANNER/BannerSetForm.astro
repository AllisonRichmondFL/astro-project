---
import { banners, SITE_ID_COOKIE as SITE_ID } from "@BANNER/banner.configs";

const { banner } = Astro.locals;
const searchParam = Astro.url.searchParams.get(SITE_ID);
if (searchParam) console.log("⛳️ banner:", banner.siteId);

const action = undefined; // `/${Astro.currentLocale}/`;
const method = undefined; // "POST";

const bannerGroups = Object.values(banners).reduce(
	(all, b) => {
		all[b.region].push(b);
		return all;
	},
	{ NA: [] as Banner[], EMEA: [] as Banner[], APAC: [] as Banner[] }
);

