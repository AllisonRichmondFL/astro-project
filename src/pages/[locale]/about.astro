---
import Layout from "@layouts/Layout.astro";
import MyReactComponent from "@components/MyReactComponent";
import SetHtml from "@components/SetHtml.astro";
import Checkbox from "@components/Checkbox.astro";
---

<Layout title="About my Astro project" main-class="max-w-screen-lg">
	<h1 class="my-16">About <span class="text-gradient">My Project</span></h1>
	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
	<SetHtml />
	<SetHtml
		htmlString=`<p>It's real, <u>raw</u>, <strong>HTML</strong> <em>content</em>!! (<a href="mailto:me@home.com">Email us to find out more</a>)</p>`
	/>
	<MyReactComponent className="my-4"> Static React component </MyReactComponent>
	<p>(Nothing will happen when you click the button)</p>

	<MyReactComponent className="bg-purple-300 text-black mt-8 mb-4" client:load>
		React component with <code>client:load</code>
	</MyReactComponent>
	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
	<Checkbox label="Astro Checkbox" name="checkbox" class="my-6" />
	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
