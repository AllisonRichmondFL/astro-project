	<MyReactComponent className="bg-purple-300 text-black my-12" client:only="react">
		React component with <code>client:only="react"</code>
	</MyReactComponent>

	<hr class="my-8" />
	<p class="my-4">
		<a href="/" class="">Go back <strong>Home</strong></a>
	</p>
</Layout>

<style>
	h1 {
		font-size: 4rem;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		margin-bottom: 1em;
	}
</style>
