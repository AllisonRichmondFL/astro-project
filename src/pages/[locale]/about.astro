	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>

	<MyReactComponent className="my-8 bg-purple-900" client:visible>
		React component with <code>client:visible</code>
	</MyReactComponent>

	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
	<p>Hey there! Welcome to my Astro project! Here we'll share everything about Astro</p>
